<mxfile host="app.diagrams.net" type="device">
  <diagram name="0 · Architecture" id="arch">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="GraphARC — a governed agent runtime" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1b1b1f;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A planner &lt;i&gt;proposes&lt;/i&gt; a subgraph, a deterministic checker &lt;i&gt;admits&lt;/i&gt; it, and only then does anything execute." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#55555a;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="800" height="24" as="geometry" />
        </mxCell>

        <!-- ================= TRIGGERS ================= -->
        <mxCell id="cT" value="WHAT STARTS A RUN" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4a90d918;strokeColor=#4a90d9;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4a90d9;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="grapharc CLI&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;eleven commands, --json on each&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#eaf2fb;strokeColor=#4a90d9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="62" y="443" width="166" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="HTTP API + SSE&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;FastAPI · grapharc serve&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#eaf2fb;strokeColor=#4a90d9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="62" y="518" width="166" height="60" as="geometry" />
        </mxCell>

        <!-- ================= OPERATOR ================= -->
        <mxCell id="cO" value="THE OPERATOR DECLARES  ·  before any model runs" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#5cb85c18;strokeColor=#5cb85c;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#3f8f3f;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="470" height="200" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;registry&lt;/b&gt;  ·  CODE&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;a name → a real function.&lt;br&gt;Absence is refusal; no wildcard.&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="165" width="205" height="72" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;policy.toml&lt;/b&gt;  ·  DATA&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;which transitions are permitted.&lt;br&gt;deny &gt; ask &gt; allow; unmatched denies.&lt;/font&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="165" width="205" height="72" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="also the operator's: the state schema, &lt;b&gt;Budget&lt;/b&gt;, &lt;b&gt;LoopLimits&lt;/b&gt;, and &lt;b&gt;grapharc.toml&lt;/b&gt; supplying any of them as a default.&amp;nbsp; flag &gt; env &gt; grapharc.toml &gt; built-in." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#55555a;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="252" width="430" height="52" as="geometry" />
        </mxCell>

        <!-- ================= CONTROL PLANE ================= -->
        <mxCell id="cC" value="THE CONTROL PLANE  ·  propose, admit, build" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d95c5c18;strokeColor=#d95c5c;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#d95c5c;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="470" height="470" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;emits a typed Subgraph as JSON.&lt;br&gt;A node names a KIND — there is no&lt;br&gt;field a body could arrive in.&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#fbf0e0;strokeColor=#d9a441;fontSize=12;size=0.08;" vertex="1" parent="1">
          <mxGeometry x="318" y="405" width="216" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;ADMISSION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;deterministic&lt;br&gt;model-free&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#d95c5c;strokeWidth=3;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="316" y="530" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;all six, every round&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;① every kind in the registry?&lt;br&gt;② args per the kind&#39;s schema?&lt;br&gt;③ every edge policy-permitted?&lt;br&gt;④ worst case within &lt;i&gt;remaining&lt;/i&gt; budget?&lt;br&gt;⑤ depth within max_depth?&lt;br&gt;⑥ acyclic?&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d95c5c;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="556" y="405" width="196" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;REFUSED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;every objection at once, each a&lt;br&gt;typed reason code. No factory ran.&lt;br&gt;Nothing was built.&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffecec;strokeColor=#ff6b6b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="556" y="540" width="196" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;materialise&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;authorisation is argument ONE,&lt;br&gt;hash-matched to the proposal.&lt;br&gt;Bodies come from the registry —&lt;br&gt;no code is ever generated.&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=12;size=0.08;" vertex="1" parent="1">
          <mxGeometry x="318" y="710" width="216" height="90" as="geometry" />
        </mxCell>

        <!-- ================= EXECUTION ================= -->
        <mxCell id="cG" value="THE GRAPH RUNS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#7aa5d218;strokeColor=#7aa5d2;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4a7fb5;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="360" width="250" height="470" as="geometry" />
        </mxCell>
        <mxCell id="g0" value="typed state · declared writes · deep-copy isolation · metered budget · code-only routing" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#4a7fb5;align=center;" vertex="1" parent="1">
          <mxGeometry x="822" y="386" width="226" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;kernel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;grapharc.runtime&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="835" y="435" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;agent nodes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;observe → model → permission&lt;br&gt;→ sandboxed tool → repeat&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="835" y="530" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;verifiers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;fresh context, anchored&lt;br&gt;to deterministic evidence&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="835" y="635" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;ProgressGuard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;target met / no progress / round cap&lt;br&gt;— a machine-readable StopReason&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f4f7fb;strokeColor=#7aa5d2;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="835" y="740" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ================= PLANES ================= -->
        <mxCell id="cP" value="THE PLANES EVERY NODE SITS ON" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4a90d918;strokeColor=#4a90d9;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4a90d9;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="880" width="820" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;model plane&lt;/b&gt;  ·  gateway&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;Claude CLI · OpenRouter&lt;br&gt;OpenAI · Ollama&lt;br&gt;retries, failover, spend ceilings&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf2fb;strokeColor=#4a90d9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="642" y="920" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;tool plane&lt;/b&gt;  ·  harness + tools&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;seven core tools, workspace-confined&lt;br&gt;permissions: deny &gt; ask &gt; allow&lt;br&gt;audit-hook sandbox · ContainerExecutor&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="907" y="920" width="245" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;memory plane&lt;/b&gt;  ·  memory&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;claims with provenance — superseded,&lt;br&gt;never overwritten. SQLite.&lt;br&gt;BM25F + graph traversal · contradiction&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fbf0e0;strokeColor=#d9a441;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1172" y="920" width="245" height="110" as="geometry" />
        </mxCell>

        <!-- ================= RECORD ================= -->
        <mxCell id="cR" value="ONE RECORD" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#a57ad218;strokeColor=#a57ad2;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#8a5bbd;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="360" width="270" height="470" as="geometry" />
        </mxCell>
        <mxCell id="r0" value="what it did  ·  what it was ALLOWED to do  ·  why it stopped" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#8a5bbd;align=center;" vertex="1" parent="1">
