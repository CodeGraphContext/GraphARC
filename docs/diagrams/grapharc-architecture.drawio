        <mxCell id="fb1" value="reason codes feed&#10;the next proposal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ff6b6b;strokeWidth=2.4;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;fontSize=10;fontColor=#d13b3b;" edge="1" parent="1" source="c3" target="c1">
