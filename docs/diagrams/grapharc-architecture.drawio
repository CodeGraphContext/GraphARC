    </mxGraphModel>
  </diagram>

  <diagram name="1 · Trust boundary" id="trust">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ttitle" value="The trust boundary — an operator declares, a model proposes, a checker decides" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1b1b1f;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="34" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="① THE OPERATOR DECLARES  ·  before any model runs" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#5cb85c18;strokeColor=#5cb85c;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#3f8f3f;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="300" height="500" as="geometry" />
        </mxCell>
        <mxCell id="b1a" value="&lt;b&gt;registry.py  ·  CODE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;a name → a real function.&lt;br&gt;'patch' = an agent with edit_file,&lt;br&gt;a token cap, one writable field.&lt;br&gt;&lt;b&gt;Absence is refusal. No wildcard.&lt;/b&gt;&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1b" value="&lt;b&gt;policy.toml  ·  DATA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;which transitions are permitted.&lt;br&gt;deny &gt; ask &gt; allow; unmatched denies.&lt;br&gt;&lt;br&gt;Named by a flag, by grapharc.toml, or —&lt;br&gt;with neither — GENERATED once, written&lt;br&gt;to .grapharc/, and disclosed as policy_source.&lt;/font&gt;" style="shape=note;size=16;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="305" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b1c" value="also the operator's, not drawn: the state schema, Budget, LoopLimits, and grapharc.toml — which supplies any of these as a default.&lt;br&gt;&lt;b&gt;flag &gt; env &gt; grapharc.toml &gt; built-in&lt;/b&gt;; parent directories are never searched." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#55555a;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="260" height="115" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="② THE MODEL PROPOSES  ·  nothing else" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d9a44118;strokeColor=#d9a441;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#a97a1f;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="300" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b2a" value="&lt;b&gt;a Subgraph, as JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;font-family:monospace;&quot;&gt;{&quot;nodes&quot;: [{&quot;name&quot;: &quot;triage&quot;}],&lt;br&gt;&amp;nbsp;&quot;edges&quot;: [...]}&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;names and edges — the whole surface&lt;/font&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;whiteSpace=wrap;html=1;fillColor=#fbf0e0;strokeColor=#d9a441;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="205" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2b" value="&lt;b&gt;CANNOT SUPPLY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;a node body — extra=&quot;forbid&quot;&lt;br&gt;a callable — not JSON-serialisable, so it&lt;br&gt;cannot be fingerprinted and never reaches the gate&lt;br&gt;its own budget or approval&lt;br&gt;a new kind — the registry is frozen&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fffaf0;strokeColor=#d9a441;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="360" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="③ THE CHECKER DECIDES  ·  deterministic, model-free" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d95c5c18;strokeColor=#d95c5c;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#d95c5c;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="130" width="310" height="460" as="geometry" />
        </mxCell>
        <mxCell id="b3a" value="&lt;b&gt;AdmissionChecker.check()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;kind registered? edge permitted?&lt;br&gt;worst case within REMAINING budget?&lt;br&gt;depth? acyclic?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#d95c5c;strokeWidth=3;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="775" y="175" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b3b" value="&lt;b&gt;REFUSED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;every objection at once, each a typed&lt;br&gt;reason code.&amp;nbsp; &lt;b&gt;No factory ran.&lt;br&gt;Nothing was built.&lt;/b&gt;&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffecec;strokeColor=#ff6b6b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="410" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="④ ONLY THEN IS ANYTHING BUILT" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#7aa5d218;strokeColor=#7aa5d2;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4a7fb5;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="160" width="300" height="400" as="geometry" />
        </mxCell>
        <mxCell id="b4a" value="&lt;b&gt;Materializer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;authorisation is argument ONE,&lt;br&gt;hash-matched to the proposal.&lt;br&gt;Bodies looked up in the registry —&lt;br&gt;&lt;b&gt;no code is ever generated.&lt;/b&gt;&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=13;size=0.06;" vertex="1" parent="1">
          <mxGeometry x="1150" y="210" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b4b" value="&lt;b&gt;the kernel runs it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;declared writes · deep-copy isolation&lt;br&gt;budget metered without the node's help&lt;br&gt;max_seconds delivered as an interrupt&lt;br&gt;&lt;i&gt;into&lt;/i&gt; the running node&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1150" y="375" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="⑤ ONE RECORD" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#a57ad218;strokeColor=#a57ad2;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#8a5bbd;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1490" y="280" width="170" height="220" as="geometry" />
        </mxCell>
        <mxCell id="b5a" value="&lt;b&gt;trace.jsonl&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;what it did&lt;br&gt;what it was&lt;br&gt;&lt;b&gt;ALLOWED&lt;/b&gt; to do&lt;br&gt;why it stopped&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f3ecfa;strokeColor=#a57ad2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1510" y="325" width="130" height="140" as="geometry" />
        </mxCell>

        <mxCell id="te1" value="the only source&#10;of a node body" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5cb85c;strokeWidth=2.4;exitX=1;exitY=0.5;entryX=0;entryY=0.35;fontSize=10;fontColor=#3f8f3f;" edge="1" parent="1" source="b1a" target="b3a">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="220" />
              <mxPoint x="370" y="90" />
              <mxPoint x="730" y="90" />
              <mxPoint x="730" y="238" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="te2" value="decides edges" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5cb85c;strokeWidth=2.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontColor=#3f8f3f;" edge="1" parent="1" source="b1b" target="b3a">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="380" />
              <mxPoint x="360" y="630" />
              <mxPoint x="740" y="630" />
              <mxPoint x="740" y="265" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="te3" value="names only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d9a441;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;fontStyle=1;fontColor=#a97a1f;" edge="1" parent="1" source="b2a" target="b3a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ff6b6b;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;fontColor=#d13b3b;" edge="1" parent="1" source="b3a" target="b3b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te5" value="ADMITTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d95c5c;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=12;fontStyle=1;fontColor=#d95c5c;" edge="1" parent="1" source="b3a" target="b4a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7aa5d2;strokeWidth=2.6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b4a" target="b4b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#a57ad2;strokeWidth=2.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4b" target="b5a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfb1" value="reason codes feed&#10;the next proposal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ff6b6b;strokeWidth=2.4;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;fontSize=10;fontColor=#d13b3b;" edge="1" parent="1" source="b3b" target="b2b">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="470" />
              <mxPoint x="720" y="540" />
              <mxPoint x="550" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tfb2" value="work discovered mid-run RE-ENTERS the gate — no already-approved path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d9a441;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=1;fontSize=11;fontStyle=1;fontColor=#a97a1f;verticalAlign=top;" edge="1" parent="1" source="b4b" target="b2a">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="700" />
              <mxPoint x="550" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="tnote" value="The other views show &lt;i&gt;structure&lt;/i&gt;. This one shows the &lt;b&gt;boundary&lt;/b&gt; — the only question that decides whether the rest is a safety argument or decoration. Everything an operator authors happens before a model runs. The model contributes exactly one thing: JSON naming kinds and edges." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#55555a;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="700" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 · Subsystems (import graph)" id="subs">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="stitle" value="Twelve subsystems — drawn from what actually imports what" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1b1b1f;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ssub" value="Line counts re-derived 2026-07-29 from &lt;font style=&quot;font-family:monospace;&quot;&gt;find grapharc/&lt;pkg&gt; -name '*.py' | xargs cat | wc -l&lt;/font&gt;. A diagram rots exactly the way prose does — re-derive before trusting it." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;fontColor=#55555a;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="sA" value="ENTRY POINTS" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4a90d918;strokeColor=#4a90d9;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4a90d9;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sa1" value="&lt;b&gt;cli/&lt;/b&gt;&amp;nbsp; 2842&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;eleven commands&lt;br&gt;--json on each&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf2fb;strokeColor=#4a90d9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="152" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sa2" value="&lt;b&gt;server/&lt;/b&gt;&amp;nbsp; 1320&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;FastAPI + SSE&lt;br&gt;&lt;b&gt;own sessions (gap)&lt;/b&gt;&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf2fb;strokeColor=#4a90d9;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="315" y="152" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sa3" value="&lt;b&gt;examples/&lt;/b&gt;&amp;nbsp; 1450&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;stages 0-6 · capstone&lt;br&gt;agent_fixit · plan_incident&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf2fb;strokeColor=#4a90d9;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="152" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sD" value="THE GOVERNED LOOP  ·  now reachable" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d9a44118;strokeColor=#d9a441;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#a97a1f;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="110" width="440" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sd1" value="&lt;font style=&quot;font-family:monospace;font-size:11px;&quot;&gt;grapharc plan &lt;goal&gt;&lt;/font&gt;&amp;nbsp; a model proposes&lt;br&gt;&lt;font style=&quot;font-family:monospace;font-size:11px;&quot;&gt;grapharc run graph.json&lt;/font&gt;&amp;nbsp; you wrote it&lt;br&gt;&lt;font style=&quot;font-family:monospace;font-size:11px;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--check-only&lt;/font&gt;&amp;nbsp; admission as a linter&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;--registry swaps the kinds (stdlib ships some)&lt;br&gt;--policy compiles a TOML into the gate&lt;br&gt;grapharc.toml supplies either as a default&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fffaf0;strokeColor=#d9a441;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="152" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sd2" value="&lt;b&gt;planner/&lt;/b&gt;&amp;nbsp; 2696&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#55555a;&quot;&gt;proposal · admission · materialize · loop&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#fbf0e0;strokeColor=#d9a441;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="890" y="315" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sB" value="CORE" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#7aa5d218;strokeColor=#7aa5d2;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4a7fb5;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sb1" value="&lt;b&gt;runtime/&lt;/b&gt;&amp;nbsp; 1960&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;typed state, declared writes,&lt;br&gt;budgets, async, traces&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="327" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sb2" value="&lt;b&gt;session/&lt;/b&gt;&amp;nbsp; 2084&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;resume across processes,&lt;br&gt;interrupt, human approval&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#e9f0f8;strokeColor=#7aa5d2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="327" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sC" value="PLANES" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#5cb85c18;strokeColor=#5cb85c;strokeWidth=1.6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#3f8f3f;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1270" height="270" as="geometry" />
        </mxCell>
        <mxCell id="sc1" value="&lt;b&gt;harness/&lt;/b&gt;&amp;nbsp; 2234&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;AgentNode, permissions,&lt;br&gt;sandbox, container executor&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="515" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sc2" value="&lt;b&gt;gateway/&lt;/b&gt;&amp;nbsp; 1679&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;Claude CLI · OpenRouter&lt;br&gt;OpenAI · Ollama · resilience · spend&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="465" y="515" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sc3" value="&lt;b&gt;memory/&lt;/b&gt;&amp;nbsp; 2530&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;claims with provenance, SQLite,&lt;br&gt;BM25F + graph traversal, contradiction&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="865" y="515" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sc4" value="&lt;b&gt;tools/&lt;/b&gt;&amp;nbsp; 1054&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;seven core tools, workspace-confined&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="625" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sc5" value="&lt;b&gt;policy/&lt;/b&gt;&amp;nbsp; 908&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;TOML rules → the admission gate&lt;br&gt;via PolicyEngine.edge_policy()&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="465" y="625" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sc6" value="&lt;b&gt;observe/&lt;/b&gt;&amp;nbsp; 1801&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#55555a;&quot;&gt;traces, replay, diff, metrics, OTel, cost&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#eaf7ea;strokeColor=#5cb85c;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="865" y="625" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4a90d9;strokeWidth=1.8;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="sa1" target="sb1">
